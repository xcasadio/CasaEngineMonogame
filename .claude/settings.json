{
  "permissions": {
    "allow": [
      "Bash(rg *)",
      "Bash(fd *)",
      "Bash(jq *)",
      "Bash(yq *)",
      "Bash(ast-grep *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git branch *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(git mv *)",
      "Bash(git rm *)",
      "Bash(git worktree *)",
      "Bash(git checkout -b *)",
      "Bash(dotnet build *)",
      "Bash(dotnet test *)"
    ],
    "deny": [
      "Bash(git push *)"
    ]
  },
  "env": {
    "CLAUDE_CODE_SUBAGENT_MODEL": "sonnet"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "powershell.exe",
            "args": [
              "-NoProfile",
              "-ExecutionPolicy",
              "Bypass",
              "-File",
              "${CLAUDE_PROJECT_DIR}/.claude/hooks/block-commit-on-main.ps1"
            ],
            "timeout": 10,
            "statusMessage": "Vérification de la branche cible (pas de commit sur main, pas de push)"
          }
        ]
      }
    ]
  }
}
