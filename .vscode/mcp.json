{
  "servers": {
    "serena": {
      "type": "stdio",
      "command": "serena",
      "args": [
        "start-mcp-server",
        "--context=vscode",
        "--project",
        "${workspaceFolder}",
        "--open-web-dashboard",
        "False"
      ]
    },
    "codegraph": {
      "type": "stdio",
      "command": "codegraph",
      "args": [
        "serve",
        "--mcp"
      ]
    },
    "casa-editor": {
      "type": "stdio",
      "command": "${workspaceFolder}/Tools/CasaEngine.Editor.Mcp/bin/Debug/net9.0/casa-editor-mcp.exe",
      "args": []
    }
  }
}
