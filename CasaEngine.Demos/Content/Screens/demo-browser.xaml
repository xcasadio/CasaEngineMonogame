<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        ScreenHorizontalAlignment="Stretch" ScreenVerticalAlignment="Stretch" ScreenMargin="0"
        IsTitleBarVisible="False"
        IsUserResizable="False"
        Padding="0">

  <!-- The demo browser beside the scene (ADR-0070). The window fills the browser's own surface, whose width the game
       sets; the scene views are kept out of it by the view manager's layout insets. No background here: the MGUI Dark
       theme supplies an opaque one, which also hides what is left of the back buffer under the browser. -->

  <Grid ColumnLengths="*,6" RowLengths="Auto,*[120,],6,180[80,],Auto">

    <DockPanel GridRow="0" GridColumn="0" Margin="8,6,6,4">
      <Button Name="btnCollapse" Dock="Right" Content="&lt;&lt;" Padding="6,1" />
      <TextBlock Name="lblHeader" Text="Demos" AllowsInlineFormatting="False" IsBold="True" FontSize="13" />
    </DockPanel>

    <!-- One item per theme, one leaf per demo, added by the screen: this tree IS the data, so it cannot be declared. -->
    <TreeView Name="treeDemos" GridRow="1" GridColumn="0" Margin="4,0,4,0" IndentSize="14" />

    <GridSplitter GridRow="2" GridColumn="0" Size="6" />

    <ScrollViewer GridRow="3" GridColumn="0" Padding="8,4"
                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Orientation="Vertical" Spacing="4">
        <TextBlock Name="lblTitle" Text="" AllowsInlineFormatting="False" IsBold="True" WrapText="True" />
        <TextBlock Name="lblTheme" Text="" AllowsInlineFormatting="False" WrapText="True" />
        <TextBlock Name="lblDescription" Text="" AllowsInlineFormatting="False" WrapText="True" />
      </StackPanel>
    </ScrollViewer>

    <TextBlock Name="lblHint" GridRow="4" GridColumn="0" Margin="8,4,8,6" AllowsInlineFormatting="False" WrapText="True"
               Text="Click a demo or press Enter to load it. F1 hides the browser." />

    <!-- The handle between the browser and the scene: the game drags it (the scene is not part of this desktop). -->
    <Border Name="bdrSceneHandle" GridRow="0" GridColumn="1" GridRowSpan="5" />

  </Grid>
</Window>
