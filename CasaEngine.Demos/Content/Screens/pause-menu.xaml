<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Width="300" Height="200"
        ScreenHorizontalAlignment="Center" ScreenVerticalAlignment="Center"
        TitleText="Pause"
        IsUserResizable="False"
        Padding="12"
        Background="rgba(20,20,40,230)">

  <StackPanel Orientation="Vertical" Spacing="10">

    <TextBlock Name="lblTitle"
               Text="[b][color=white]Game Paused[/color][/b]"
               Margin="0,0,0,8" />

    <TextBlock Name="lblDescription"
               Text="[color=lightgray]Click [b]Resume[/b] to continue\nor close the app.[/color]" />

    <Button Name="btnResume" Margin="0,12,0,0">
      <TextBlock Text="[color=lightgreen]Resume[/color]" />
    </Button>

  </StackPanel>
</Window>
