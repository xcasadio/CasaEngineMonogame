<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Left="10" Top="10" Width="320"
        IsTitleBarVisible="False"
        IsUserResizable="False"
        Padding="8">

  <!-- No Background here on purpose. This window's fill is the reference pixel the smoke samples to tell
       the BelowUI layer from the AboveUI one, so it comes from ScreenEffectSmokeHudScreen.ReferenceColor,
       which the check reads. A colour written in both places could drift apart in silence. -->

  <!-- No Height on purpose. With only a Width declared the window sizes its height to its content, so every
       row keeps its room when a hint line wraps wider under the real font. A fixed Height used to cut the
       last rows off: the content outgrew it with no warning. -->
  <StackPanel Orientation="Vertical" Spacing="4">

    <TextBlock Name="lblTitle" Text="[b][color=black]Screen effect above-UI smoke[/color][/b]" />

    <TextBlock Name="lblBelowUiHint" Text="[color=black]Press 1: alpha fade to black and back, BelowUI (default)[/color]" />

    <TextBlock Name="lblAboveUiHint" Text="[color=black]Press 2: alpha fade to black and back, AboveUI[/color]" />

    <TextBlock Name="lblExpectation"
               Text="[color=darkgray]In AboveUI this window darkens with the scene.[/color]"
               Margin="0,4,0,0" />

  </StackPanel>
</Window>
