<UserControl x:Class="CasaEngine.EditorUI.Controls.EntityControls.EntityComponentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             xmlns:sys="clr-namespace:System;assembly=System.Runtime"
             xmlns:physics="clr-namespace:CasaEngine.Engine.Physics;assembly=CasaEngine"
             xmlns:wpfControls="clr-namespace:CasaEngine.WpfControls;assembly=CasaEngine.WpfControls"
             xmlns:xna="clr-namespace:Microsoft.Xna.Framework;assembly=MonoGame.Framework"
             xmlns:graphics="clr-namespace:Microsoft.Xna.Framework.Graphics;assembly=MonoGame.Framework"
             xmlns:entityControls="clr-namespace:CasaEngine.EditorUI.Controls.EntityControls"
             xmlns:common="clr-namespace:CasaEngine.EditorUI.Controls.Common"
             xmlns:components="clr-namespace:CasaEngine.Framework.Entities.Components;assembly=CasaEngine"
             xmlns:shapes="clr-namespace:CasaEngine.Framework.Graphics.Shapes;assembly=CasaEngine"
             mc:Ignorable="d" 
             d:DesignHeight="150" d:DesignWidth="400">
    <Control.Resources>
        <ObjectDataProvider x:Key="ExternalComponentRegistered" MethodName="GetData" 
                            ObjectType="{x:Type entityControls:GameplayProxyClassesRegisteredDataAccess}" />

        <entityControls:ScriptClassNameConverter x:Key="ScriptClassNameConverter" />

        <DataTemplate x:Key="physicsDefinitionComponentTemplate" DataType="{x:Type physics:PhysicsDefinition}">
            <Expander Header="Physics Definition" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:PhysicsDefinitionComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="CompoundTemplate" DataType="{x:Type shapes:Shape3dCompound}">
            <ItemsControl ItemsSource="{Binding Shapes}" >
                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type shapes:Shape3d}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Text="{Binding Type}" />
                            <ContentControl Grid.Row="1" Content="{Binding }" ContentTemplateSelector="{StaticResource ShapeTemplateSelectorWithoutCompound}"/>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </DataTemplate>

        <DataTemplate x:Key="animatedSpriteComponentTemplate" DataType="{x:Type components:AnimatedSpriteComponent}">
            <Expander Header="Animated sprite" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:AnimatedSpriteComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="staticSpriteComponentTemplate" DataType="{x:Type components:StaticSpriteComponent}">
            <Expander Header="Sprite" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:StaticSpriteComponentControl />
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="meshComponentTemplate" DataType="{x:Type components:StaticMeshComponent}">
            <Expander Header="Mesh" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:StaticMeshComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="skinnedMeshComponentTemplate" DataType="{x:Type components:SkinnedMeshComponent}">
            <Expander Header="Mesh" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:SkinnedMeshComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="staticModelComponentTemplate" DataType="{x:Type components:StaticModelComponent}">
            <Expander Header="Static Model" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:StaticModelComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="arcBallCameraComponentTemplate" DataType="{x:Type components:ArcBallCameraComponent}">
            <Expander Header="Arc ball camera" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:ArcBallCameraComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="camera3dIn2dAxisComponentTemplate" DataType="{x:Type components:Camera3dIn2dAxisComponent}" >
            <Expander Header="Camera 3d in 2d axis" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:Camera3dIn2dAxisComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="cameraLookAtComponentTemplate" DataType="{x:Type components:CameraLookAtComponent}" >
            <Expander Header="Camera look at" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:CameraLookAtComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="cameraTargeted2dComponentTemplate" DataType="{x:Type components:CameraTargeted2dComponent}" >
            <Expander Header="Camera targeted 2d" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:CameraTargeted2dComponentComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="boxCollisionComponentTemplate" DataType="{x:Type components:BoxCollisionComponent}" >
            <Expander Header="Box collision" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:BoxCollisionComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="capsuleCollisionComponentTemplate" DataType="{x:Type components:CapsuleCollisionComponent}" >
            <Expander Header="Capsule collision" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:CapsuleCollisionComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="circleCollisionComponentTemplate" DataType="{x:Type components:CircleCollisionComponent}" >
            <Expander Header="Camera 3d in 2d axis" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:CircleCollisionComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="cylinderCollisionComponentTemplate" DataType="{x:Type components:CylinderCollisionComponent}" >
            <Expander Header="Cylinder collision" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:CylinderCollisionComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="sphereCollisionComponentTemplate" DataType="{x:Type components:SphereCollisionComponent}" >
            <Expander Header="Sphere collision" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:SphereCollisionComponentControl/>
            </Expander>
        </DataTemplate>
        <DataTemplate x:Key="playerStartComponentTemplate" DataType="{x:Type components:PlayerStartComponent}" >
            <Expander Header="Player start" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <entityControls:PlayerStartComponentControl/>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="physicsComponentTemplate" DataType="{x:Type components:PhysicsBaseComponent}">
            <Grid>
                <ContentControl Content="{Binding PhysicsDefinition}"
                                ContentTemplate="{StaticResource physicsDefinitionComponentTemplate}"/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="box2dCollisionComponentTemplate" DataType="{x:Type components:Box2dCollisionComponent}">
            <Grid>
                <entityControls:Box2dCollisionComponentControl/>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="tileMapComponentTemplate" DataType="{x:Type components:TileMapComponent}">
            <Expander Header="Tile map" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <Grid>
                    <common:AssetSelectorControl AssetId="{Binding TileMapDataAssetId, Mode=TwoWay}"
                                                 ValidateAsset="ValidateTileMapAsset"/>
                </Grid>
            </Expander>
        </DataTemplate>

        <DataTemplate x:Key="staticModelSubMeshComponentTemplate">
            <Expander Header="Sub Mesh" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto"/>
                        <ColumnDefinition Width="*"/>
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Mesh" Margin="0,0,5,0"/>
                    <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding MeshName}"/>
                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Vertices" Margin="0,0,5,0"/>
                    <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding VertexCount}"/>
                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Indices" Margin="0,0,5,0"/>
                    <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding IndexCount}"/>
                </Grid>
            </Expander>
        </DataTemplate>

    </Control.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <Expander Grid.Row="0" Header="Transform" HorizontalAlignment="Stretch" IsExpanded="True" VerticalContentAlignment="Top">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                        <RowDefinition Height="auto"/>
                    </Grid.RowDefinitions>

                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="0" Grid.Column="0" Text="Position" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <wpfControls:Vector3Editor x:Name="Vector3ControlPosition" Grid.Row="0" Grid.Column="1" HorizontalAlignment="Stretch" Value="{Binding Coordinates.Position}"/>

                    <TextBlock Grid.Row="1" Grid.Column="0" Text="Orientation" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <wpfControls:RotationEditor x:Name="RotationControl" Grid.Row="1" Grid.Column="1" HorizontalAlignment="Stretch" Value="{Binding Coordinates.Orientation}"/>

                    <TextBlock Grid.Row="2" Grid.Column="0" Text="Scale" Margin="0,0,5,0" VerticalAlignment="Center"/>
                    <wpfControls:Vector3Editor x:Name="Vector3ControlScale" Grid.Row="2" Grid.Column="1" HorizontalAlignment="Stretch" Value="{Binding Coordinates.Scale}"/>
                </Grid>
            </Expander>

            <ContentControl Grid.Row="1" x:Name="componentControl" Content="{Binding}" 
                        HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
                <ContentControl.ContentTemplateSelector>
                    <entityControls:EntityComponentTemplateSelector
                        ArcBallCameraComponentTemplate="{StaticResource arcBallCameraComponentTemplate}"
                        Camera3dIn2dAxisComponentTemplate="{StaticResource camera3dIn2dAxisComponentTemplate}"
                        CameraLookAtComponentTemplate="{StaticResource cameraLookAtComponentTemplate}"
                        CameraTargeted2dComponentTemplate="{StaticResource cameraTargeted2dComponentTemplate}"
                        MeshComponentTemplate="{StaticResource meshComponentTemplate}"
                        SkinnedMeshComponentTemplate="{StaticResource skinnedMeshComponentTemplate}"
                        StaticModelComponentTemplate="{StaticResource staticModelComponentTemplate}"
                        StaticModelSubMeshComponentTemplate="{StaticResource staticModelSubMeshComponentTemplate}"
                        PhysicsComponentTemplate="{StaticResource physicsComponentTemplate}"
                        Box2dCollisionComponentTemplate="{StaticResource box2dCollisionComponentTemplate}"
                        BoxCollisionComponentTemplate="{StaticResource boxCollisionComponentTemplate}"
                        CapsuleCollisionComponentTemplate="{StaticResource capsuleCollisionComponentTemplate}"
                        CircleCollisionComponentTemplate="{StaticResource circleCollisionComponentTemplate}"
                        CylinderCollisionComponentTemplate="{StaticResource cylinderCollisionComponentTemplate}"
                        SphereCollisionComponentTemplate="{StaticResource sphereCollisionComponentTemplate}"
                        PlayerStartComponentTemplate="{StaticResource playerStartComponentTemplate}"
                        TileMapComponentTemplate="{StaticResource tileMapComponentTemplate}"
                        StaticSpriteComponentTemplate="{StaticResource staticSpriteComponentTemplate}"
                        AnimatedSpriteComponentTemplate="{StaticResource animatedSpriteComponentTemplate}" />
                </ContentControl.ContentTemplateSelector>
            </ContentControl>
        </Grid>
    </ScrollViewer>
</UserControl>
