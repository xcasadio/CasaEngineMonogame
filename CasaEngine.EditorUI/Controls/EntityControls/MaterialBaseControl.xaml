<UserControl x:Class="CasaEngine.EditorUI.Controls.EntityControls.MaterialBaseControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CasaEngine.EditorUI.Controls.EntityControls"
             xmlns:viewModels="clr-namespace:CasaEngine.EditorUI.Controls.EntityControls.ViewModels"
             mc:Ignorable="d"
             d:DesignHeight="300" d:DesignWidth="400">
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="130"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
            <RowDefinition Height="auto"/>
        </Grid.RowDefinitions>

        <!-- Name -->
        <TextBlock Grid.Row="0" Grid.Column="0" Text="Name" VerticalAlignment="Center" Margin="0,2"/>
        <TextBox   Grid.Row="0" Grid.Column="1" Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Margin="2"/>

        <!-- Flags -->
        <TextBlock Grid.Row="1" Grid.Column="0" Text="Is Transparent" VerticalAlignment="Center" Margin="0,2"/>
        <CheckBox  Grid.Row="1" Grid.Column="1" IsChecked="{Binding IsTransparent}" Margin="2" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Cast Shadows" VerticalAlignment="Center" Margin="0,2"/>
        <CheckBox  Grid.Row="2" Grid.Column="1" IsChecked="{Binding CastShadows}" Margin="2" VerticalAlignment="Center"/>

        <TextBlock Grid.Row="3" Grid.Column="0" Text="Receive Shadows" VerticalAlignment="Center" Margin="0,2"/>
        <CheckBox  Grid.Row="3" Grid.Column="1" IsChecked="{Binding ReceiveShadows}" Margin="2" VerticalAlignment="Center"/>

        <!-- Queue -->
        <TextBlock Grid.Row="4" Grid.Column="0" Text="Render Queue" VerticalAlignment="Center" Margin="0,2"/>
        <ComboBox  Grid.Row="4" Grid.Column="1" Margin="2"
                   ItemsSource="{x:Static viewModels:MaterialViewModel.AvailableQueues}"
                   SelectedItem="{Binding Queue}"/>

        <!-- Render States -->
        <TextBlock Grid.Row="5" Grid.Column="0" Text="Blend State" VerticalAlignment="Center" Margin="0,2"/>
        <ComboBox  Grid.Row="5" Grid.Column="1" Margin="2"
                   ItemsSource="{x:Static viewModels:MaterialViewModel.AvailableBlendStates}"
                   SelectedItem="{Binding BlendStateName}"/>

        <TextBlock Grid.Row="6" Grid.Column="0" Text="Depth / Stencil" VerticalAlignment="Center" Margin="0,2"/>
        <ComboBox  Grid.Row="6" Grid.Column="1" Margin="2"
                   ItemsSource="{x:Static viewModels:MaterialViewModel.AvailableDepthStencilStates}"
                   SelectedItem="{Binding DepthStencilStateName}"/>

        <TextBlock Grid.Row="7" Grid.Column="0" Text="Rasterizer" VerticalAlignment="Center" Margin="0,2"/>
        <ComboBox  Grid.Row="7" Grid.Column="1" Margin="2"
                   ItemsSource="{x:Static viewModels:MaterialViewModel.AvailableRasterizerStates}"
                   SelectedItem="{Binding RasterizerStateName}"/>

        <TextBlock Grid.Row="8" Grid.Column="0" Text="Sampler" VerticalAlignment="Center" Margin="0,2"/>
        <ComboBox  Grid.Row="8" Grid.Column="1" Margin="2"
                   ItemsSource="{x:Static viewModels:MaterialViewModel.AvailableSamplerStates}"
                   SelectedItem="{Binding SamplerStateName}"/>

        <!-- Save button -->
        <Button Grid.Row="9" Grid.Column="1" Content="Save Material" Margin="2,4"
                HorizontalAlignment="Right" Click="SaveMaterial_Click"/>
    </Grid>
</UserControl>
