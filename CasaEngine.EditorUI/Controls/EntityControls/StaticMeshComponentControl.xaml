<UserControl x:Class="CasaEngine.EditorUI.Controls.EntityControls.StaticMeshComponentControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:common="clr-namespace:CasaEngine.EditorUI.Controls.Common"
             mc:Ignorable="d" Height="94" Width="451">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
            <RowDefinition Height="auto" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="auto"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <StackPanel Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="2" Orientation="Horizontal" HorizontalAlignment="Stretch">
            <TextBlock Text="Mesh : " />
            <TextBlock Text="nb vertices = " />
            <TextBlock Text="{Binding VertexCount}" />
            <Button Content="Select Mesh" Click="StaticMeshComponent_MeshSelection_OnClick"/>
        </StackPanel>

        <TextBlock Grid.Row="1" Grid.Column="0" Text="Mesh" />
        <common:AssetSelectorControl Grid.Row="1" Grid.Column="1"
                                     AssetId="{Binding MeshAssetId, Mode=TwoWay}"
                                     ValidateAsset="ValidateStaticMeshAsset"/>

        <TextBlock Grid.Row="2" Grid.Column="0" Text="Texture" />
        <common:AssetSelectorControl Grid.Row="2" Grid.Column="1"
                                     AssetId="{Binding TextureAssetId, Mode=TwoWay}"
                                     ValidateAsset="ValidateTextureAsset"/>
    </Grid>
</UserControl>
