<UserControl x:Class="CasaEngine.EditorUI.Controls.EntityControls.UnlitTextureMaterialControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:local="clr-namespace:CasaEngine.EditorUI.Controls.EntityControls"
             xmlns:common="clr-namespace:CasaEngine.EditorUI.Controls.Common"
             xmlns:wpfControls="clr-namespace:CasaEngine.WpfControls;assembly=CasaEngine.WpfControls"
             mc:Ignorable="d"
             d:DesignHeight="250" d:DesignWidth="400">
    <StackPanel>
        <!-- Common material properties -->
        <local:MaterialBaseControl DataContext="{Binding}"/>

        <Separator Margin="0,4"/>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="130"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
                <RowDefinition Height="auto"/>
            </Grid.RowDefinitions>

            <!-- Albedo Texture -->
            <TextBlock Grid.Row="0" Grid.Column="0" Text="Albedo Texture" VerticalAlignment="Center" Margin="0,2"/>
            <common:AssetSelectorControl Grid.Row="0" Grid.Column="1" Margin="2"
                                         ValidateAsset="ValidateTextureAsset"
                                         AssetId="{Binding AlbedoAssetId, Mode=TwoWay}"/>

            <!-- Tint Color -->
            <TextBlock Grid.Row="1" Grid.Column="0" Text="Tint" VerticalAlignment="Center" Margin="0,2"/>
            <wpfControls:ColorEditor Grid.Row="1" Grid.Column="1" Margin="2"
                                     Value="{Binding Tint}"/>

            <!-- Alpha -->
            <TextBlock Grid.Row="2" Grid.Column="0" Text="Alpha" VerticalAlignment="Center" Margin="0,2"/>
            <Grid Grid.Row="2" Grid.Column="1" Margin="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="50"/>
                </Grid.ColumnDefinitions>
                <Slider Grid.Column="0" Minimum="0" Maximum="1" SmallChange="0.01"
                        Value="{Binding Alpha, Mode=TwoWay}" VerticalAlignment="Center"/>
                <TextBox Grid.Column="1" Text="{Binding Alpha, StringFormat=F2, UpdateSourceTrigger=PropertyChanged}"
                         Margin="2,0,0,0"/>
            </Grid>
        </Grid>
    </StackPanel>
</UserControl>
