<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>$(WindowsTargetFramework)</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    
    
    <IsPackable>false</IsPackable>
    <NoWarn>1701;1702;1573;1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
  <PackageReference Include="Microsoft.NET.Test.Sdk" />
  <PackageReference Include="xunit" />
  <PackageReference Include="xunit.runner.visualstudio">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  <PackageReference Include="Microsoft.CodeAnalysis.CSharp" />
  <PackageReference Include="coverlet.collector">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <None Include="Audio\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
    <None Include="EditorServices\Fixtures\**" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The demos main screen, tested on its own source (ai-agent/tasks/demos-main-menu-tasks.md, T5.4): the demos app is a
       WinExe that builds MonoGame content, so the screen and its XAML are linked here instead of referencing the app.
       The XAML lands where DemoScreenXaml looks for it: Content/Screens beside the test assembly. -->
  <ItemGroup>
    <Compile Include="..\CasaEngine.Demos\Demos\DemoUI\MainMenuScreen.cs" Link="Demos\MainMenuScreen.cs" />
    <Compile Include="..\CasaEngine.Demos\Demos\DemoUI\DemoScreenXaml.cs" Link="Demos\DemoScreenXaml.cs" />
    <Compile Include="..\CasaEngine.Demos\DemoControl.cs" Link="Demos\DemoControl.cs" />
    <Compile Include="..\CasaEngine.Demos\DemoSheetText.cs" Link="Demos\DemoSheetText.cs" />
    <Compile Include="..\CasaEngine.Demos\DemoBindingText.cs" Link="Demos\DemoBindingText.cs" />
    <Compile Include="..\CasaEngine.Demos\Demos\DemoUI\DemoHelpOverlay.cs" Link="Demos\DemoHelpOverlay.cs" />
    <Compile Include="..\CasaEngine.Demos\Demos\AnimationHudText.cs" Link="Demos\AnimationHudText.cs" />
    <Compile Include="..\CasaEngine.Demos\Demos\AudioHudText.cs" Link="Demos\AudioHudText.cs" />
    <None Include="..\CasaEngine.Demos\Content\Screens\main-menu.xaml" Link="Content\Screens\main-menu.xaml" CopyToOutputDirectory="PreserveNewest" />
    <None Include="..\CasaEngine.Demos\Content\Screens\demo-help.xaml" Link="Content\Screens\demo-help.xaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- The polygons and the read-back of the primitive batch of the proof of FillPolygon (ai-agent/tasks/mgui-polygon-triangulation-tasks.md, T1.2):
       the same sources as the tests of MGUI, linked so that the corpus of T1.1 exists once. -->
  <ItemGroup>
    <Compile Include="..\MGUI\MGUI.Tests\Rendering\PolygonCorpus.cs" Link="UI\Backend\PolygonCorpus.cs" />
    <Compile Include="..\MGUI\MGUI.Tests\Rendering\PrimitiveBatchProbe.cs" Link="UI\Backend\PrimitiveBatchProbe.cs" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasaEngine.Compiler\CasaEngine.Compiler.csproj" />
    <ProjectReference Include="..\CasaEngine\CasaEngine.csproj" />
    <ProjectReference Include="..\CasaEngine.Editor\CasaEngine.Editor.csproj" />
    <ProjectReference Include="..\CasaEngine.EditorServices\CasaEngine.EditorServices.csproj" />
    <ProjectReference Include="..\CasaEngine.Shaders\CasaEngine.Shaders.csproj" />
    <ProjectReference Include="..\Tools\CasaEngine.Editor.Remote.Protocol\CasaEngine.Editor.Remote.Protocol.csproj" />
    <ProjectReference Include="..\Tools\CasaEngine.Editor.Cli\CasaEngine.Editor.Cli.csproj" />
    <ProjectReference Include="..\Tools\CasaEngine.Editor.Mcp\CasaEngine.Editor.Mcp.csproj" />
  </ItemGroup>

</Project>