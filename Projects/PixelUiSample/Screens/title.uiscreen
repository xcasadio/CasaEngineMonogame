        { "type": "wait_fade" },
        { "type": "change_world", "target": "BlackWorld.world" }
      ]
    },
    {
      "name": "Quit",
      "actions": [
        { "type": "quit" }
      ]
    },
    {
      "name": "Move",
      "actions": [
        { "type": "play_sound", "target": "cursor_move" }
      ]
    }
  ]
