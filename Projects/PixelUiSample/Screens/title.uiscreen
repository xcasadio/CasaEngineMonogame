  "default_focus": "btnStart",
  "focus_wrap": "vertical",
  "move_command": "Move",
  "fonts": [ "pixel-block" ],
  "ui_commands": [
    {
      "name": "Start",
      "actions": [
        { "type": "change_world", "target": "NextWorld.world" }
      ]
    },
    {
      "name": "Options",
      "actions": [
