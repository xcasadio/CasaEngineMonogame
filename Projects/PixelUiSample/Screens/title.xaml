<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Left="40" Top="10" Width="240" Height="160" WindowStyle="None" IsCloseButtonVisible="False" CanCloseWindow="False">
  <StackPanel Orientation="Vertical" Spacing="6" Padding="8">
    <TextBlock Name="lblTitle" FontFamily="pixel-block" Foreground="White" Text="PIXEL UI SAMPLE" />
    <TextBlock Name="lblSize" FontFamily="pixel-block" Foreground="Yellow" Text="320 X 180 DESIGN PIXELS" />
    <Button Name="btnStart" CommandName="Start">
      <TextBlock FontFamily="pixel-block" Foreground="White" Text="START" />
    </Button>
    <Button Name="btnOptions" CommandName="Options">
      <TextBlock FontFamily="pixel-block" Foreground="White" Text="OPTIONS" />
    </Button>
    <Button Name="btnFade" CommandName="FadeOut">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <OverlayPanel Name="cursorFade" Background="rgb(208,176,128)" VerticalAlignment="Center">
          <Image SourceName="cursor-body" Stretch="None" />
          <Image SourceName="cursor-shade" Stretch="None" BlendType="Subtractive" />
        </OverlayPanel>
        <TextBlock FontFamily="pixel-block" Foreground="White" VerticalAlignment="Center" Text="FADE OUT" />
      </StackPanel>
    </Button>
    <Button Name="btnQuit" CommandName="Quit">
      <TextBlock FontFamily="pixel-block" Foreground="White" Text="QUIT" />
    </Button>
  </StackPanel>
</Window>
