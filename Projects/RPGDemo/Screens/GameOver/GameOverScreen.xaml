<Window xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        Left="0" Top="0" Width="380" Height="180"
        IsTitleBarVisible="False"
        IsUserResizable="False"
        Padding="24"
        Background="rgba(5,0,0,230)">

  <!-- Left and Top are placeholders: the screen centres this on the desktop at load. -->

  <StackPanel Orientation="Vertical" Spacing="18">

    <TextBlock Name="lblGameOver"
               Text="[b][color=red]GAME OVER[/color][/b]"
               HorizontalAlignment="Center" />

    <Button Name="btnReturnToTitle" HorizontalAlignment="Center">
      <TextBlock Text="[color=lightgray]Return to Title[/color]" />
    </Button>

  </StackPanel>
</Window>
