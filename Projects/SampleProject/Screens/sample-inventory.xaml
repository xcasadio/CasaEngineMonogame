<DockPanel xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
           xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
           Name="pnlInventory"
           Padding="0"
           Width="640"
           Height="480">

  <!-- Header -->
  <DockPanel.Top>
    <Border Padding="12,8,12,8">
      <StackPanel Orientation="Horizontal" Spacing="16">
        <TextBlock Name="lblInventoryTitle" Text="Inventory" FontSize="16" />
        <TextBlock Name="lblCapacity" Text="12 / 20 slots" Opacity="0.7" VerticalAlignment="Center" />
      </StackPanel>
    </Border>
  </DockPanel.Top>

  <!-- Footer buttons -->
  <DockPanel.Bottom>
    <StackPanel Orientation="Horizontal" Spacing="8" Padding="12,8,12,8">
      <Button Name="btnEquip" Padding="12,6,12,6">
        <TextBlock Text="Equip" />
      </Button>
      <Button Name="btnDrop" Padding="12,6,12,6">
        <TextBlock Text="Drop" />
      </Button>
      <Button Name="btnClose" Padding="12,6,12,6" HorizontalAlignment="Right">
        <TextBlock Text="Close" />
      </Button>
    </StackPanel>
  </DockPanel.Bottom>

  <!-- Item grid placeholder -->
  <Border Padding="12">
    <StackPanel Orientation="Vertical" Spacing="4">
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Border Name="pnlSlot1" Width="64" Height="64" Padding="4"><TextBlock Text="Sword" WrapText="True" /></Border>
        <Border Name="pnlSlot2" Width="64" Height="64" Padding="4"><TextBlock Text="Shield" WrapText="True" /></Border>
        <Border Name="pnlSlot3" Width="64" Height="64" Padding="4"><TextBlock Text="Potion" WrapText="True" /></Border>
        <Border Name="pnlSlot4" Width="64" Height="64" Padding="4"><TextBlock Text="Bow" WrapText="True" /></Border>
        <Border Name="pnlSlot5" Width="64" Height="64" Padding="4"><TextBlock Text="" /></Border>
      </StackPanel>
      <StackPanel Orientation="Horizontal" Spacing="4">
        <Border Name="pnlSlot6" Width="64" Height="64" Padding="4"><TextBlock Text="Helmet" WrapText="True" /></Border>
        <Border Name="pnlSlot7" Width="64" Height="64" Padding="4"><TextBlock Text="Boots" WrapText="True" /></Border>
        <Border Name="pnlSlot8" Width="64" Height="64" Padding="4"><TextBlock Text="" /></Border>
        <Border Name="pnlSlot9" Width="64" Height="64" Padding="4"><TextBlock Text="" /></Border>
        <Border Name="pnlSlot10" Width="64" Height="64" Padding="4"><TextBlock Text="" /></Border>
      </StackPanel>
    </StackPanel>
  </Border>

</DockPanel>
