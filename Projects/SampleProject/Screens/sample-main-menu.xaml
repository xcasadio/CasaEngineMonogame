<MGStackPanel xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="pnlMainMenu"
             Orientation="Vertical"
             Spacing="16"
             Padding="32"
             HorizontalAlignment="Center"
             VerticalAlignment="Center">

  <MGTextBlock Name="lblGameTitle"
               Text="My Awesome Game"
               FontSize="32"
               HorizontalAlignment="Center"
               Margin="0,0,0,24" />

  <MGButton Name="btnPlay"
            Padding="16,8,16,8"
            HorizontalAlignment="Stretch">
    <MGTextBlock Text="Play" HorizontalAlignment="Center" />
  </MGButton>

  <MGButton Name="btnSettings"
            Padding="16,8,16,8"
            HorizontalAlignment="Stretch">
    <MGTextBlock Text="Settings" HorizontalAlignment="Center" />
  </MGButton>

  <MGButton Name="btnCredits"
            Padding="16,8,16,8"
            HorizontalAlignment="Stretch">
    <MGTextBlock Text="Credits" HorizontalAlignment="Center" />
  </MGButton>

  <MGButton Name="btnQuit"
            Padding="16,8,16,8"
            HorizontalAlignment="Stretch"
            Margin="0,16,0,0">
    <MGTextBlock Text="Quit" HorizontalAlignment="Center" />
  </MGButton>

</MGStackPanel>
