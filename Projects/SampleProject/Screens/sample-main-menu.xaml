<StackPanel xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
            xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
            Name="pnlMainMenu"
            Orientation="Vertical"
            Spacing="16"
            Padding="32"
            HorizontalAlignment="Center"
            VerticalAlignment="Center">

  <TextBlock Name="lblGameTitle"
             Text="My Awesome Game"
             FontSize="32"
             HorizontalAlignment="Center"
             Margin="0,0,0,24" />

  <Button Name="btnPlay"
          Padding="16,8,16,8"
          HorizontalAlignment="Stretch">
    <TextBlock Text="Play" HorizontalAlignment="Center" />
  </Button>

  <Button Name="btnSettings"
          Padding="16,8,16,8"
          HorizontalAlignment="Stretch">
    <TextBlock Text="Settings" HorizontalAlignment="Center" />
  </Button>

  <Button Name="btnCredits"
          Padding="16,8,16,8"
          HorizontalAlignment="Stretch">
    <TextBlock Text="Credits" HorizontalAlignment="Center" />
  </Button>

  <Button Name="btnQuit"
          Padding="16,8,16,8"
          HorizontalAlignment="Stretch"
          Margin="0,16,0,0">
    <TextBlock Text="Quit" HorizontalAlignment="Center" />
  </Button>

</StackPanel>
