<MGDockPanel xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Name="pnlOptions"
             Padding="0"
             Width="560"
             Height="400">

  <!-- Title -->
  <MGDockPanel.Top>
    <MGBorder Padding="16,12,16,12">
      <MGTextBlock Name="lblOptionsTitle" Text="Options" FontSize="18" HorizontalAlignment="Center" />
    </MGBorder>
  </MGDockPanel.Top>

  <!-- Close button -->
  <MGDockPanel.Bottom>
    <MGStackPanel Orientation="Horizontal" HorizontalAlignment="Right" Padding="16,8,16,8">
      <MGButton Name="btnApply" Padding="12,6,12,6" Margin="0,0,8,0">
        <MGTextBlock Text="Apply" />
      </MGButton>
      <MGButton Name="btnOptionsClose" Padding="12,6,12,6">
        <MGTextBlock Text="Close" />
      </MGButton>
    </MGStackPanel>
  </MGDockPanel.Bottom>

  <!-- Options content -->
  <MGStackPanel Orientation="Vertical" Spacing="16" Padding="24">

    <!-- Volume -->
    <MGStackPanel Orientation="Horizontal" Spacing="12">
      <MGTextBlock Name="lblVolume" Text="Master Volume" Width="160" VerticalAlignment="Center" />
      <MGTextBlock Name="lblVolumeValue" Text="80%" VerticalAlignment="Center" />
    </MGStackPanel>

    <!-- Music -->
    <MGStackPanel Orientation="Horizontal" Spacing="12">
      <MGTextBlock Name="lblMusic" Text="Music Volume" Width="160" VerticalAlignment="Center" />
      <MGTextBlock Name="lblMusicValue" Text="60%" VerticalAlignment="Center" />
    </MGStackPanel>

    <!-- SFX -->
    <MGStackPanel Orientation="Horizontal" Spacing="12">
      <MGTextBlock Name="lblSfx" Text="SFX Volume" Width="160" VerticalAlignment="Center" />
      <MGTextBlock Name="lblSfxValue" Text="100%" VerticalAlignment="Center" />
    </MGStackPanel>

    <!-- Fullscreen toggle -->
    <MGStackPanel Orientation="Horizontal" Spacing="12">
      <MGTextBlock Name="lblFullscreen" Text="Fullscreen" Width="160" VerticalAlignment="Center" />
      <MGCheckBox Name="chkFullscreen" />
    </MGStackPanel>

    <!-- Language -->
    <MGStackPanel Orientation="Horizontal" Spacing="12">
      <MGTextBlock Name="lblLanguage" Text="Language" Width="160" VerticalAlignment="Center" />
      <MGTextBlock Name="lblLanguageValue" Text="English" VerticalAlignment="Center" />
    </MGStackPanel>

  </MGStackPanel>

</MGDockPanel>
