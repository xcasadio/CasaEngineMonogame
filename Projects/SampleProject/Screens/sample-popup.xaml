<Border xmlns="clr-namespace:MGUI.Core.UI.XAML;assembly=MGUI.Core"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Name="pnlConfirmDialog"
        Padding="24"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Width="400">

  <StackPanel Orientation="Vertical" Spacing="16">

    <TextBlock Name="lblTitle"
               Text="Confirm Action"
               FontSize="18"
               HorizontalAlignment="Center" />

    <TextBlock Name="lblMessage"
               Text="Are you sure you want to continue? This action cannot be undone."
               WrapText="True"
               HorizontalAlignment="Center" />

    <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Center">
      <Button Name="btnConfirm" Padding="16,8,16,8">
        <TextBlock Text="Confirm" />
      </Button>
      <Button Name="btnCancel" Padding="16,8,16,8">
        <TextBlock Text="Cancel" />
      </Button>
    </StackPanel>

  </StackPanel>
</Border>
