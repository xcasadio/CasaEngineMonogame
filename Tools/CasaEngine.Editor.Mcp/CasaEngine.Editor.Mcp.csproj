<Project Sdk="Microsoft.NET.Sdk">
  <!-- ADR-0092: MCP server (stdio) that exposes the commands of a running editor as MCP tools. -->
  <PropertyGroup>
    <TargetFramework>$(BaseTargetFramework)</TargetFramework>
    <OutputType>Exe</OutputType>
    <AssemblyName>casa-editor-mcp</AssemblyName>
    <RootNamespace>CasaEngine.Editor.Mcp</RootNamespace>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ModelContextProtocol" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\CasaEngine.Editor.Remote.Protocol\CasaEngine.Editor.Remote.Protocol.csproj" />
  </ItemGroup>
</Project>
